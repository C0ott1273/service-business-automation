{
  "name": "Daily Digest — 7AM Schedule Push",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "0 7 * * *" }]
        }
      },
      "id": "cron-trigger",
      "name": "Every Day at 7AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "=https://www.googleapis.com/calendar/v3/calendars/{{$env.GOOGLE_CALENDAR_ID}}/events",
        "qs": {
          "key": "={{$env.GOOGLE_CALENDAR_API_KEY}}",
          "timeMin": "={{new Date(new Date().setHours(0,0,0,0)).toISOString()}}",
          "timeMax": "={{new Date(new Date().setHours(23,59,59,999)).toISOString()}}",
          "singleEvents": "true",
          "orderBy": "startTime"
        }
      },
      "id": "fetch-calendar",
      "name": "Fetch Today's Events",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [470, 300]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.first().json.items || [];\nconst lines = items.map((e, i) => {\n  const time = e.start?.dateTime ? new Date(e.start.dateTime).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true }) : 'All day';\n  const loc = e.location ? ` @ ${e.location}` : '';\n  return `${i+1}. ${time} — ${e.summary}${loc}`;\n});\n\nconst summary = lines.length > 0 \n  ? `Good morning! Here are your ${lines.length} job(s) today:\\n\\n${lines.join('\\n')}`\n  : 'Good morning! No jobs scheduled for today.';\n\nreturn [{ json: { summary, jobCount: lines.length } }];"
      },
      "id": "format-digest",
      "name": "Format Daily Digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [690, 300]
    },
    {
      "parameters": {
        "chatId": "={{$env.TELEGRAM_CHAT_ID}}",
        "text": "={{$json.summary}}"
      },
      "id": "send-telegram",
      "name": "Send to Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [910, 300],
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_TELEGRAM_CREDENTIAL_ID",
          "name": "Telegram Bot"
        }
      }
    }
  ],
  "connections": {
    "Every Day at 7AM": {
      "main": [[{ "node": "Fetch Today's Events", "type": "main", "index": 0 }]]
    },
    "Fetch Today's Events": {
      "main": [[{ "node": "Format Daily Digest", "type": "main", "index": 0 }]]
    },
    "Format Daily Digest": {
      "main": [[{ "node": "Send to Telegram", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "meta": { "description": "Phase 2: Every morning at 7AM, fetch today's Google Calendar events and send a formatted digest via Telegram." }
}
