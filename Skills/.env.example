# ===========================
# Service Business Automation
# ===========================
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.

# --- Email (IMAP) ---
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_USER=your-email@gmail.com
EMAIL_IMAP_PASS=your-app-password

# --- Twilio SMS ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# --- Google Calendar ---
GOOGLE_CALENDAR_API_KEY=your-api-key
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com

# --- QuickBooks ---
QUICKBOOKS_CLIENT_ID=your-client-id
QUICKBOOKS_CLIENT_SECRET=your-client-secret
QUICKBOOKS_REALM_ID=your-realm-id
QUICKBOOKS_ACCESS_TOKEN=your-access-token
QUICKBOOKS_REFRESH_TOKEN=your-refresh-token
QUICKBOOKS_SANDBOX=true

# --- Review Link ---
REVIEW_LINK=https://g.page/r/your-google-review-link

# --- Dashboard ---
DASHBOARD_PORT=3000
